NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://atlas:change-me-postgres@127.0.0.1:5432/atlas_rag
REDIS_URL=redis://:change-me-redis@127.0.0.1:6379
ELASTICSEARCH_URL=http://elastic:change-me-elastic@127.0.0.1:9200
AI_SERVICE_URL=http://127.0.0.1:8001
URL_CAPTURE_MAX_BYTES=20971520
URL_CAPTURE_MAX_REDIRECTS=5
URL_CAPTURE_TIMEOUT_MS=30000
MINIO_ENDPOINT=127.0.0.1
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=atlas
MINIO_SECRET_KEY=change-me-minio
MINIO_QUARANTINE_BUCKET=atlas-rag-quarantine
MINIO_DOCUMENT_BUCKET=atlas-rag-documents
EVENT_STREAM=atlas:events
EVENT_DEAD_LETTER_STREAM=atlas:events:dead-letter
WORKER_CONSUMER_GROUP=rag-ai-ingestion-v1
WORKER_CONSUMER_NAME=rag-ai-worker-1
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-characters
JWT_REFRESH_PEPPER=change-me-refresh-pepper-at-least-32-characters
COOKIE_SECURE=false
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=
# To switch from mock to real AI, set provider=openai and provide a key:
# EMBEDDING_PROVIDER=openai
# EMBEDDING_VERSION=text-embedding-3-small
# EMBEDDING_DIMENSIONS=1536
# LLM_PROVIDER=openai
# LLM_VERSION=gpt-4o-mini
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=  # optional, for proxies or compatible APIs like SiliconFlow
# RERANKER_PROVIDER=bailian
# RERANKER_VERSION=qwen3-rerank
# RERANKER_API_KEY=sk-...
# Replace {WorkspaceId} with your Bailian business workspace ID.
# RERANKER_BASE_URL=https://{WorkspaceId}.cn-beijing.maas.aliyuncs.com/compatible-api/v1/reranks
# RERANKER_TIMEOUT_SECONDS=15
# For SiliconFlow's Qwen reranker, only the API key is required.
# RERANKER_PROVIDER=siliconflow
# RERANKER_VERSION=Qwen/Qwen3-Reranker-8B
# RERANKER_API_KEY=sk-...
# RERANKER_BASE_URL=https://api.siliconflow.cn/v1/rerank  # optional
